  <data name="TemplateCom" xml:space="preserve"><value>; A .COM program: the code starts at offset 100h.
org 100h

start:
    mov dx, message     ; DS:DX = the text
    mov ah, 09h         ; DOS: print a $-terminated string
    int 21h

    mov ax, 4C00h       ; DOS: end the program, exit code 0
    int 21h

message db 'Hello, World!', 13, 10, '$'
</value><comment>Starter template for New .COM Program (FR-002). New documents are saved with CRLF (FR-020) whatever the line breaks here</comment></data>
