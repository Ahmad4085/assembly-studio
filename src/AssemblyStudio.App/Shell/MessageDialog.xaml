<Window x:Class="AssemblyStudio.App.Shell.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Raised}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource FontSize.UI}"
        UseLayoutRounding="True">
  <!-- UI-019 MessageDialog: what happened, where (in the text), the next step, and actions. The default button is the safest. -->
  <DockPanel Margin="16">
    <StackPanel x:Name="Buttons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" />
    <StackPanel>
      <TextBlock x:Name="Heading" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock x:Name="Message" TextWrapping="Wrap" />
      <TextBlock x:Name="NextStep" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text.Secondary}" />
    </StackPanel>
  </DockPanel>
</Window>
