<Window x:Class="AssemblyStudio.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:AssemblyStudio.App.Shell"
        xmlns:learn="clr-namespace:AssemblyStudio.App.Learn"
        xmlns:content="clr-namespace:AssemblyStudio.Content;assembly=AssemblyStudio.Content"
        xmlns:about="clr-namespace:AssemblyStudio.App.About"
        xmlns:docs="clr-namespace:AssemblyStudio.App.Documents"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=shell:ShellViewModel}"
        Title="{x:Static shell:Strings.AppTitle}"
        MinWidth="{x:Static shell:LayoutState.MinWindowWidth}"
        MinHeight="{x:Static shell:LayoutState.MinWindowHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource FontSize.UI}"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        FocusManager.FocusedElement="{Binding ElementName=EditorPanel}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static shell:MainWindow.NextPaneCommand}" Executed="OnNextPane" />
    <CommandBinding Command="{x:Static shell:MainWindow.PreviousPaneCommand}" Executed="OnPreviousPane" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="F6" Command="{x:Static shell:MainWindow.NextPaneCommand}" />
    <KeyBinding Key="F6" Modifiers="Shift" Command="{x:Static shell:MainWindow.PreviousPaneCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Registers}" />
    <KeyBinding Key="F" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Flags}" />
    <KeyBinding Key="M" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Memory}" />
    <KeyBinding Key="K" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Stack}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Console}" />
    <KeyBinding Key="P" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Problems}" />
    <KeyBinding Key="U" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Runtime}" />
    <KeyBinding Key="H" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.History}" />
    <KeyBinding Key="B" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Breakpoints}" />
    <KeyBinding Key="L" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Learn}" />
    <!-- File commands (ui-spec section 6) -->
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Workspace.NewFileCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding Workspace.OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Workspace.SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding Workspace.SaveAsCommand}" />
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Workspace.CloseTabCommand}" />
    <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding Workspace.CloseTabCommand}" />
  </Window.InputBindings>

  <DockPanel Background="{DynamicResource Surface.Window}">
    <!-- UI-002 menus. Commands owned by later tasks are shown (with their shortcuts) but disabled. -->
    <Menu DockPanel.Dock="Top" AutomationProperties.Name="{x:Static shell:Strings.RegionMenu}" Padding="4,2">
      <MenuItem Header="{x:Static shell:Strings.MenuFile}">
        <MenuItem Header="{x:Static shell:Strings.CmdNew}" InputGestureText="{x:Static shell:Strings.KeyNew}" Command="{Binding Workspace.NewFileCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdNewFromTemplate}" Command="{Binding Workspace.NewProgramCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdOpen}" InputGestureText="{x:Static shell:Strings.KeyOpen}" Command="{Binding Workspace.OpenCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdSave}" InputGestureText="{x:Static shell:Strings.KeySave}" Command="{Binding Workspace.SaveCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdSaveAs}" InputGestureText="{x:Static shell:Strings.KeySaveAs}" Command="{Binding Workspace.SaveAsCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdCloseTab}" InputGestureText="{x:Static shell:Strings.KeyCloseTab}" Command="{Binding Workspace.CloseTabCommand}" />
        <MenuItem x:Name="RecentMenu" Header="{x:Static shell:Strings.CmdRecent}" ItemsSource="{Binding Workspace.RecentFiles}"
                  IsEnabled="{Binding Workspace.HasRecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <!-- The path is the header; no access-key underscores in file names. -->
              <Setter Property="Header">
                <Setter.Value>
                  <TextBlock Text="{Binding}" />
                </Setter.Value>
              </Setter>
              <Setter Property="Command" Value="{Binding DataContext.Workspace.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdSettings}" InputGestureText="{x:Static shell:Strings.KeySettings}" Command="{Binding OpenSettingsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdExit}" InputGestureText="{x:Static shell:Strings.KeyExit}" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuEdit}">
        <MenuItem Header="{x:Static shell:Strings.CmdUndo}" InputGestureText="{x:Static shell:Strings.KeyUndo}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdRedo}" InputGestureText="{x:Static shell:Strings.KeyRedo}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdCut}" InputGestureText="{x:Static shell:Strings.KeyCut}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdCopy}" InputGestureText="{x:Static shell:Strings.KeyCopy}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdPaste}" InputGestureText="{x:Static shell:Strings.KeyPaste}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdSelectAll}" InputGestureText="{x:Static shell:Strings.KeySelectAll}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdFind}" InputGestureText="{x:Static shell:Strings.KeyFind}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdFindNext}" InputGestureText="{x:Static shell:Strings.KeyFindNext}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdFindPrevious}" InputGestureText="{x:Static shell:Strings.KeyFindPrevious}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdReplace}" InputGestureText="{x:Static shell:Strings.KeyReplace}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdGoToLine}" InputGestureText="{x:Static shell:Strings.KeyGoToLine}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdTabMovesFocus}" InputGestureText="{x:Static shell:Strings.KeyTabMovesFocus}" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuView}">
        <MenuItem Header="{x:Static shell:Strings.CmdNextPane}" InputGestureText="{x:Static shell:Strings.KeyNextPane}"
                  Command="{x:Static shell:MainWindow.NextPaneCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdPreviousPane}" InputGestureText="{x:Static shell:Strings.KeyPreviousPane}"
                  Command="{x:Static shell:MainWindow.PreviousPaneCommand}" />
        <MenuItem Header="{x:Static shell:Strings.MenuGoTo}">
          <MenuItem Header="{x:Static shell:Strings.GoRegisters}" InputGestureText="{x:Static shell:Strings.KeyGoRegisters}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Registers}" />
          <MenuItem Header="{x:Static shell:Strings.GoFlags}" InputGestureText="{x:Static shell:Strings.KeyGoFlags}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Flags}" />
          <MenuItem Header="{x:Static shell:Strings.GoMemory}" InputGestureText="{x:Static shell:Strings.KeyGoMemory}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Memory}" />
          <MenuItem Header="{x:Static shell:Strings.GoStack}" InputGestureText="{x:Static shell:Strings.KeyGoStack}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Stack}" />
          <Separator />
          <MenuItem Header="{x:Static shell:Strings.GoConsole}" InputGestureText="{x:Static shell:Strings.KeyGoConsole}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Console}" />
          <MenuItem Header="{x:Static shell:Strings.GoProblems}" InputGestureText="{x:Static shell:Strings.KeyGoProblems}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Problems}" />
          <MenuItem Header="{x:Static shell:Strings.GoRuntime}" InputGestureText="{x:Static shell:Strings.KeyGoRuntime}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Runtime}" />
          <MenuItem Header="{x:Static shell:Strings.GoHistory}" InputGestureText="{x:Static shell:Strings.KeyGoHistory}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.History}" />
          <MenuItem Header="{x:Static shell:Strings.GoBreakpoints}" InputGestureText="{x:Static shell:Strings.KeyGoBreakpoints}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Breakpoints}" />
          <MenuItem Header="{x:Static shell:Strings.GoLearn}" InputGestureText="{x:Static shell:Strings.KeyGoLearn}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Learn}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdShowLearn}" IsCheckable="True" IsChecked="{Binding IsLearnVisible}" />
        <MenuItem Header="{x:Static shell:Strings.CmdShowMachine}" IsCheckable="True" IsChecked="{Binding IsMachineVisible}" />
        <MenuItem Header="{x:Static shell:Strings.CmdShowBottom}" IsCheckable="True" IsChecked="{Binding IsBottomVisible}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomIn}" InputGestureText="{x:Static shell:Strings.KeyZoomIn}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomOut}" InputGestureText="{x:Static shell:Strings.KeyZoomOut}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomReset}" InputGestureText="{x:Static shell:Strings.KeyZoomReset}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdResetLayout}" Command="{Binding ResetLayoutCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuBuild}">
        <MenuItem Header="{x:Static shell:Strings.CmdBuild}" InputGestureText="{x:Static shell:Strings.KeyBuild}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdCancelBuild}" InputGestureText="{x:Static shell:Strings.KeyCancelBuild}" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuDebug}">
        <MenuItem Header="{x:Static shell:Strings.CmdRun}" InputGestureText="{x:Static shell:Strings.KeyRun}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdPause}" InputGestureText="{x:Static shell:Strings.KeyPause}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdStop}" InputGestureText="{x:Static shell:Strings.KeyStop}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdReset}" InputGestureText="{x:Static shell:Strings.KeyReset}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdStepInto}" InputGestureText="{x:Static shell:Strings.KeyStepInto}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdStepOver}" InputGestureText="{x:Static shell:Strings.KeyStepOver}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdToggleBreakpoint}" InputGestureText="{x:Static shell:Strings.KeyToggleBreakpoint}" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuLearn}">
        <MenuItem Header="{x:Static shell:Strings.CmdSamples}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Sample}" />
        <MenuItem Header="{x:Static shell:Strings.CmdTutorials}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Tutorial}" />
        <MenuItem Header="{x:Static shell:Strings.CmdReference}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Reference}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuHelp}">
        <MenuItem Header="{x:Static shell:Strings.CmdHelp}" InputGestureText="{x:Static shell:Strings.KeyHelp}" IsEnabled="False" />
        <MenuItem Header="{x:Static shell:Strings.CmdReleaseNotes}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.ReleaseNotes}" />
        <MenuItem Header="{x:Static shell:Strings.CmdNotices}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.Notices}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdAbout}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.Diagnostics}" />
      </MenuItem>
    </Menu>

    <!-- UI-002 command bar. Session commands are disabled in the Empty state (ui-spec section 4). -->
    <Border DockPanel.Dock="Top" MinHeight="{DynamicResource Size.CommandBar}" Padding="8,2"
            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{x:Static shell:Strings.RegionCommandBar}">
        <Button Style="{StaticResource CommandButton}" Tag="&#xE90F;" Content="{x:Static shell:Strings.BarBuild}" ToolTip="{x:Static shell:Strings.TipBuild}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE768;" Content="{x:Static shell:Strings.BarRun}" ToolTip="{x:Static shell:Strings.TipRun}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE769;" Content="{x:Static shell:Strings.BarPause}" ToolTip="{x:Static shell:Strings.TipPause}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE71A;" Content="{x:Static shell:Strings.BarStop}" ToolTip="{x:Static shell:Strings.TipStop}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE72C;" Content="{x:Static shell:Strings.BarReset}" ToolTip="{x:Static shell:Strings.TipReset}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE74B;" Content="{x:Static shell:Strings.BarStepInto}" ToolTip="{x:Static shell:Strings.TipStepInto}" IsEnabled="False" />
        <Button Style="{StaticResource CommandButton}" Tag="&#xE7A6;" Content="{x:Static shell:Strings.BarStepOver}" ToolTip="{x:Static shell:Strings.TipStepOver}" IsEnabled="False" />
      </StackPanel>
    </Border>

    <!-- UI-016 status bar. -->
    <Border DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
            AutomationProperties.Name="{x:Static shell:Strings.RegionStatusBar}">
      <DockPanel>
        <!-- Encoding and line endings of the active document (ui-spec section 5) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Workspace.ActiveDocument}"
                    Visibility="{Binding DataContext.Workspace.HasDocuments, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock x:Name="StatusEncoding" Text="{Binding StatusEncoding}" Foreground="{DynamicResource Text.Secondary}"
                     FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
          <TextBlock x:Name="StatusLineEnding" Text="{Binding StatusLineEnding}" Foreground="{DynamicResource Text.Secondary}"
                     FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Foreground="{DynamicResource Text.Secondary}"
                   FontSize="{DynamicResource FontSize.UI.Small}" />
      </DockPanel>
    </Border>

    <!-- Regions (ui-spec section 2). Sizes and visibility are applied by the code-behind from the view model. -->
    <Grid x:Name="RegionGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LearnColumn" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="MachineColumn" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="BottomRow" />
      </Grid.RowDefinitions>

      <!-- UI-015 Learn sidebar -->
      <GroupBox x:Name="LearnPanel" Grid.Column="0" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderLearn}"
                AutomationProperties.Name="{x:Static shell:Strings.RegionLearn}">
        <Grid DataContext="{Binding Learn}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TreeView x:Name="LearnTree" ItemsSource="{Binding Sections}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Background="Transparent" Foreground="{DynamicResource Text.Primary}"
                    AutomationProperties.Name="{x:Static shell:Strings.LearnTreeName}" SelectedItemChanged="OnLearnSelectionChanged">
            <TreeView.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
            </TreeView.InputBindings>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type learn:LearnSectionViewModel}" ItemsSource="{Binding Items}">
                <StackPanel>
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Text.Secondary}" FontStyle="Italic"
                             Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type learn:LearnItemViewModel}">
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Summary}" />
              </DataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                <Setter Property="ItemContainerStyle">
                  <Setter.Value>
                    <Style TargetType="TreeViewItem">
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                      <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
                    </Style>
                  </Setter.Value>
                </Setter>
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,4" />
          <!-- Details of the selected entry -->
          <DockPanel x:Name="LearnDetails" Grid.Row="2" Margin="4,0,4,4">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.LearnSelectHint}"
                       Visibility="{Binding HasSelection, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,6" />
            <Button x:Name="LearnOpenTutorialSample" DockPanel.Dock="Top" Command="{Binding OpenLinkedSampleCommand}"
                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding LinkedSampleLabel}"
                    Visibility="{Binding LinkedSampleLabel, Converter={x:Static shell:NullToCollapsedConverter.Instance}}">
              <TextBlock Text="{Binding LinkedSampleLabel}" TextWrapping="Wrap" />
            </Button>
            <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsSampleSelected, Converter={StaticResource VisibleWhenTrue}}">
              <Button x:Name="LearnOpenCopy" Content="{x:Static shell:Strings.LearnOpenCopy}" Command="{Binding OpenSelectedCommand}"
                      HorizontalAlignment="Left" Padding="12,4" />
              <TextBlock Text="{x:Static shell:Strings.LearnOpenCopyHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static shell:Strings.LearnExplanation}" Foreground="{DynamicResource Text.Secondary}"
                       FontStyle="Italic" Margin="0,0,0,2"
                       Visibility="{Binding SelectedText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
            <TextBox x:Name="LearnText" Text="{Binding SelectedText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4"
                     Background="{DynamicResource Surface.Raised}" Foreground="{DynamicResource Text.Primary}"
                     Visibility="{Binding SelectedText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}"
                     AutomationProperties.Name="{x:Static shell:Strings.LearnTextName}" />
          </DockPanel>
        </Grid>
      </GroupBox>
      <GridSplitter x:Name="LearnSplitter" Grid.Column="1" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterLearn}" />

      <!-- UI-003 editor area: document tabs (the AvalonEdit editor replaces the text boxes in TASK-064), or the UI-020 welcome page -->
      <GroupBox x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource Panel.Headerless}"
                AutomationProperties.Name="{x:Static shell:Strings.RegionEditor}" DataContext="{Binding Workspace}">
        <Grid>
          <!-- UI-020 welcome page: no document open -->
          <ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static shell:Strings.RegionWelcome}">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasDocuments}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="16">
              <TextBlock Style="{StaticResource EmptyState.Title}" Text="{x:Static shell:Strings.WelcomeTitle}" />
              <TextBlock Style="{StaticResource EmptyState.Text}" TextAlignment="Center" Text="{x:Static shell:Strings.WelcomeText}" />
              <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="WelcomeNew" Content="{x:Static shell:Strings.WelcomeNew}" Command="{Binding NewFileCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeNewProgram" Content="{x:Static shell:Strings.WelcomeNewTemplate}" Command="{Binding NewProgramCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeOpen" Content="{x:Static shell:Strings.WelcomeOpen}" Command="{Binding OpenCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeSample" Content="{x:Static shell:Strings.WelcomeSample}" Margin="4" Padding="12,4"
                        Command="{Binding DataContext.ShowLearnSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static content:ContentKind.Sample}" />
              </WrapPanel>
              <TextBlock Text="{x:Static shell:Strings.WelcomeRecent}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="4,20,4,4" />
              <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.WelcomeNoRecent}"
                         Visibility="{Binding HasRecentFiles, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
              <ItemsControl x:Name="WelcomeRecent" ItemsSource="{Binding RecentFiles}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" HorizontalContentAlignment="Left" Margin="4,1" Padding="8,2"
                            AutomationProperties.Name="{Binding}">
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Open documents -->
          <DockPanel x:Name="DocumentArea" Visibility="{Binding HasDocuments, Converter={StaticResource VisibleWhenTrue}}">
            <!-- Tab strip only: each document keeps its own editor below, so caret and undo history stay per tab (AC-006). -->
            <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                        AutomationProperties.Name="{x:Static shell:Strings.RegionDocumentTabs}">
              <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                  <Setter Property="ToolTip" Value="{Binding FilePath}" />
                </Style>
              </TabControl.ItemContainerStyle>
              <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" />
                    <Button Margin="8,0,0,0" Padding="2,0" FontFamily="{DynamicResource Font.Icons}" FontSize="10" Content="&#xE711;"
                            Focusable="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Secondary}"
                            ToolTip="{x:Static shell:Strings.CmdCloseTabShort}" AutomationProperties.Name="{x:Static shell:Strings.CmdCloseTabShort}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
              <TabControl.ContentTemplate>
                <DataTemplate />
              </TabControl.ContentTemplate>
            </TabControl>

            <ItemsControl x:Name="DocumentEditors" ItemsSource="{Binding Documents}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Grid />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource VisibleWhenTrue}}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
                  <DockPanel>
                    <!-- FR-019: not UTF-8 -->
                    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Status.Warning}" BorderThickness="0,0,0,1"
                            Visibility="{Binding EncodingNotice, Converter={x:Static shell:NullToCollapsedConverter.Instance}}">
                      <TextBlock Text="{Binding EncodingNotice}" TextWrapping="Wrap" />
                    </Border>
                    <!-- FR-020: mixed line endings -->
                    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Status.Warning}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasMixedLineEndings, Converter={StaticResource VisibleWhenTrue}}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static shell:Strings.BannerNormalize}" Padding="8,2" Margin="8,0,0,0"
                                Command="{Binding DataContext.NormalizeLineEndingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{x:Static shell:Strings.BannerMixedLineEndings}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <TextBox x:Name="EditorText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource Font.Editor}" FontSize="{DynamicResource FontSize.Editor}"
                             Background="{DynamicResource Surface.Editor}" Foreground="{DynamicResource Syntax.Text}"
                             CaretBrush="{DynamicResource Text.Primary}" SelectionBrush="{DynamicResource Editor.Selection}"
                             BorderThickness="0" Padding="4,2" AutomationProperties.Name="{Binding Title}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Grid>
      </GroupBox>

      <GridSplitter x:Name="MachineSplitter" Grid.Column="3" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterMachine}" />

      <!-- Machine column: UI-005 registers above UI-006 flags -->
      <Grid x:Name="MachineRegion" Grid.Column="4" AutomationProperties.Name="{x:Static shell:Strings.RegionMachine}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox x:Name="RegistersPanel" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderRegisters}">
          <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
        </GroupBox>
        <GroupBox x:Name="FlagsPanel" Grid.Row="1" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderFlags}"
                  BorderThickness="0,1,0,0" MinHeight="96">
          <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
        </GroupBox>
      </Grid>

      <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.ColumnSpan="5" Height="{DynamicResource Size.Splitter}"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows" AutomationProperties.Name="{x:Static shell:Strings.SplitterBottom}" />

      <!-- Bottom area: UI-010..UI-014 tab group; UI-008 memory and UI-009 stack beside it (tabs when compact) -->
      <Grid x:Name="BottomRegion" Grid.Row="2" Grid.ColumnSpan="5" AutomationProperties.Name="{x:Static shell:Strings.RegionBottom}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition x:Name="MemoryStackColumn" />
        </Grid.ColumnDefinitions>
        <TabControl x:Name="BottomTabs" SelectedIndex="{Binding BottomTab, Converter={x:Static shell:EnumIndexConverter.Instance}}"
                    AutomationProperties.Name="{x:Static shell:Strings.RegionBottomTabs}">
          <TabItem Header="{x:Static shell:Strings.TabConsole}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyConsole}" />
          </TabItem>
          <TabItem Header="{x:Static shell:Strings.TabProblems}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyProblems}" />
          </TabItem>
          <TabItem Header="{x:Static shell:Strings.TabRuntime}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyRuntime}" />
          </TabItem>
          <TabItem Header="{x:Static shell:Strings.TabHistory}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyHistory}" />
          </TabItem>
          <TabItem Header="{x:Static shell:Strings.TabBreakpoints}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyBreakpoints}" />
          </TabItem>
          <TabItem x:Name="MemoryTab" Header="{x:Static shell:Strings.TabMemory}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
          </TabItem>
          <TabItem x:Name="StackTab" Header="{x:Static shell:Strings.TabStack}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
          </TabItem>
        </TabControl>
        <GridSplitter x:Name="MemoryStackSplitter" Grid.Column="1" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                      ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterMemoryStack}" />
        <Grid x:Name="MemoryStackGroup" Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <GroupBox x:Name="MemoryPanel" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderMemory}">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
          </GroupBox>
          <GroupBox x:Name="StackView" Grid.Column="1" Width="180" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderStack}"
                    BorderThickness="1,0,0,0">
            <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyMachine}" />
          </GroupBox>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
