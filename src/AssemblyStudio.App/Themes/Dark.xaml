<!--
  Design tokens, dark theme (docs/04-design/design-tokens.md v1.0, sections 1, 4 and 5).
  Views reference these keys only, never literal values (ui-spec section 9). The light and
  high-contrast dictionaries, theme switching and the contrast test arrive with TASK-061.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Color tokens -->
  <SolidColorBrush x:Key="Surface.Window" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Surface.Panel" Color="#232428" />
  <SolidColorBrush x:Key="Surface.Raised" Color="#2B2D32" />
  <SolidColorBrush x:Key="Surface.Editor" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Surface.Gutter" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Editor.CurrentLine" Color="#26282C" />
  <SolidColorBrush x:Key="Editor.ExecutionLine" Color="#3A3420" />
  <SolidColorBrush x:Key="Editor.Selection" Color="#1D3550" />
  <SolidColorBrush x:Key="Border.Subtle" Color="#34373D" />
  <SolidColorBrush x:Key="Border.Strong" Color="#7A808A" />
  <SolidColorBrush x:Key="Text.Primary" Color="#E8E9EB" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#BFC3C9" />
  <SolidColorBrush x:Key="Text.Muted" Color="#9BA1AA" />
  <SolidColorBrush x:Key="Text.Disabled" Color="#62666D" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="#0B1220" />
  <SolidColorBrush x:Key="Accent.Primary" Color="#5AA2FF" />
  <SolidColorBrush x:Key="Focus.Ring" Color="#5AA2FF" />
  <SolidColorBrush x:Key="Accent.ExecutionArrow" Color="#F5C542" />
  <SolidColorBrush x:Key="Accent.Breakpoint" Color="#F0605A" />
  <SolidColorBrush x:Key="Status.Error" Color="#FF7B72" />
  <SolidColorBrush x:Key="Status.Warning" Color="#E3B341" />
  <SolidColorBrush x:Key="Status.Info" Color="#79B8FF" />
  <SolidColorBrush x:Key="Status.Success" Color="#5FB870" />
  <SolidColorBrush x:Key="Value.Changed" Color="#FFD866" />

  <!-- Typography. Font sizes are scaled at startup by the Windows text scale factor (NFR-026). -->
  <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Code">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="FontSize.UI">13</sys:Double>
  <sys:Double x:Key="FontSize.UI.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Title">15</sys:Double>
  <sys:Double x:Key="FontSize.Code">14</sys:Double>

  <!-- Spacing and sizes -->
  <Thickness x:Key="Space.Pad.Panel">8,4,8,4</Thickness>
  <Thickness x:Key="Space.Pad.Button">8,4,8,4</Thickness>
  <sys:Double x:Key="Size.PanelHeader">28</sys:Double>
  <sys:Double x:Key="Size.CommandBar">36</sys:Double>
  <sys:Double x:Key="Size.Splitter">4</sys:Double>
  <CornerRadius x:Key="Radius.Small">2</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
</ResourceDictionary>
