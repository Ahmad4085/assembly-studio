<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Per-monitor DPI awareness (NFR-026) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- WPF shell and composition root (ADR-0001, ADR-0002, ADR-0007) -->
  <ItemGroup>
    <ProjectReference Include="..\AssemblyStudio.Core\AssemblyStudio.Core.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Engine.I8086\AssemblyStudio.Engine.I8086.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Runtime\AssemblyStudio.Runtime.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Os.Dos\AssemblyStudio.Os.Dos.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Toolchain.Nasm\AssemblyStudio.Toolchain.Nasm.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Debugging\AssemblyStudio.Debugging.csproj" />
    <ProjectReference Include="..\AssemblyStudio.Content\AssemblyStudio.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- FR-079: the NASM fetched by build/fetch-nasm.ps1 (tools/nasm, git-ignored, ADR-0005) is placed next to the
       application as tools\nasm\, where the composition root looks for the bundled assembler. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\nasm\nasm.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\nasm\nasm.exe;$(MSBuildThisFileDirectory)..\..\tools\nasm\LICENSE"
          Link="tools\nasm\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AssemblyStudio.App.Tests" />
  </ItemGroup>
</Project>
