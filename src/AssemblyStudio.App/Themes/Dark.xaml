<!--
  Design tokens, dark theme: the color and syntax tokens of docs/04-design/design-tokens.md v1.0 sections 1 and 2.
  Views reference these keys only, never literal values (ui-spec section 9). Shared.xaml holds the tokens that are
  the same in every theme (typography, spacing, sizes). ThemeTokenTests checks these values against the token table
  and the WCAG contrast pairs, so edit the table and this file together.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Color tokens -->
  <SolidColorBrush x:Key="Surface.Window" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Surface.Panel" Color="#232428" />
  <SolidColorBrush x:Key="Surface.Raised" Color="#2B2D32" />
  <SolidColorBrush x:Key="Surface.Editor" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Surface.Gutter" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Editor.CurrentLine" Color="#26282C" />
  <SolidColorBrush x:Key="Editor.ExecutionLine" Color="#3A3420" />
  <SolidColorBrush x:Key="Editor.Selection" Color="#1D3550" />
  <SolidColorBrush x:Key="Border.Subtle" Color="#34373D" />
  <SolidColorBrush x:Key="Border.Strong" Color="#7A808A" />
  <SolidColorBrush x:Key="Text.Primary" Color="#E8E9EB" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#BFC3C9" />
  <SolidColorBrush x:Key="Text.Muted" Color="#9BA1AA" />
  <SolidColorBrush x:Key="Text.Disabled" Color="#62666D" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="#0B1220" />
  <SolidColorBrush x:Key="Accent.Primary" Color="#5AA2FF" />
  <SolidColorBrush x:Key="Focus.Ring" Color="#5AA2FF" />
  <SolidColorBrush x:Key="Accent.ExecutionArrow" Color="#F5C542" />
  <SolidColorBrush x:Key="Accent.Breakpoint" Color="#F0605A" />
  <SolidColorBrush x:Key="Status.Error" Color="#FF7B72" />
  <SolidColorBrush x:Key="Status.Warning" Color="#E3B341" />
  <SolidColorBrush x:Key="Status.Info" Color="#79B8FF" />
  <SolidColorBrush x:Key="Status.Success" Color="#5FB870" />
  <SolidColorBrush x:Key="Value.Changed" Color="#FFD866" />

  <!-- Control tokens (design tokens v1.1, TASK-112) -->
  <SolidColorBrush x:Key="Control.Input" Color="#1B1C1F" />
  <SolidColorBrush x:Key="Control.Button" Color="#303237" />
  <SolidColorBrush x:Key="Control.Hover" Color="#3D4148" />
  <SolidColorBrush x:Key="Control.Pressed" Color="#474B53" />
  <SolidColorBrush x:Key="Control.Selected" Color="#1D3550" />
  <SolidColorBrush x:Key="Accent.Primary.Hover" Color="#7AB4FF" />
  <SolidColorBrush x:Key="Control.Text" Color="#E8E9EB" />
  <SolidColorBrush x:Key="Control.Text.Selected" Color="#E8E9EB" />

  <!-- Syntax tokens (editor, NASM 8086) -->
  <SolidColorBrush x:Key="Syntax.Mnemonic" Color="#82AAFF" />
  <SolidColorBrush x:Key="Syntax.Register" Color="#F7A072" />
  <SolidColorBrush x:Key="Syntax.Directive" Color="#D3A6F5" />
  <SolidColorBrush x:Key="Syntax.Number" Color="#F2C76E" />
  <SolidColorBrush x:Key="Syntax.String" Color="#B5E08A" />
  <SolidColorBrush x:Key="Syntax.Comment" Color="#A3AAB4" />
  <SolidColorBrush x:Key="Syntax.Label" Color="#7FDBCA" />
  <SolidColorBrush x:Key="Syntax.Text" Color="#E8E9EB" />
</ResourceDictionary>
