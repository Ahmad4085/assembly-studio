<Window x:Class="AssemblyStudio.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:AssemblyStudio.App.Shell"
        xmlns:editor="clr-namespace:AssemblyStudio.App.Editor"
        xmlns:learn="clr-namespace:AssemblyStudio.App.Learn"
        xmlns:content="clr-namespace:AssemblyStudio.Content;assembly=AssemblyStudio.Content"
        xmlns:about="clr-namespace:AssemblyStudio.App.About"
        xmlns:docs="clr-namespace:AssemblyStudio.App.Documents"
        xmlns:console="clr-namespace:AssemblyStudio.App.Panels.Console"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=shell:ShellViewModel}"
        Title="{x:Static shell:Strings.AppTitle}"
        MinWidth="{x:Static shell:LayoutState.MinWindowWidth}"
        MinHeight="{x:Static shell:LayoutState.MinWindowHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource FontSize.UI}"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        FocusManager.FocusedElement="{Binding ElementName=EditorPanel}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <!-- TASK-081 ValueCell (ui-spec section 7, D-017): the value in a box in the code font. Changed = Value.Changed + FontWeight.Changed
         + an outline (the outline and weight are the non-color cues). -->
    <DataTemplate x:Key="RegisterChipTemplate">
      <Border x:Name="Chip" Background="{DynamicResource Surface.Raised}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="6,0" Margin="0,1">
        <TextBlock x:Name="ChipValue" Text="{Binding Text}" Foreground="{DynamicResource Syntax.Number}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChanged}" Value="True">
          <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="ChipValue" Property="Foreground" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="ChipValue" Property="FontWeight" Value="{DynamicResource FontWeight.Changed}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- One register row: "AX [000A]  AH [00]  AL [0A]" (D-017); the halves wrap below when the format is too wide (binary). -->
    <DataTemplate x:Key="RegisterRowTemplate">
      <DockPanel Margin="0,1">
        <Border x:Name="Marker" DockPanel.Dock="Left" Width="2" Margin="0,2,6,2" Background="Transparent" />
        <TextBlock DockPanel.Dock="Left" Width="44" VerticalAlignment="Center" Text="{Binding Main.Name}" Foreground="{DynamicResource Accent.Primary}"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" FontWeight="SemiBold" />
        <WrapPanel VerticalAlignment="Center">
          <ContentControl Content="{Binding Main}" ContentTemplate="{StaticResource RegisterChipTemplate}" Focusable="False" />
          <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding HasHalves, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding High.Name}" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.UI.Small}" />
            <ContentControl Content="{Binding High}" ContentTemplate="{StaticResource RegisterChipTemplate}" Focusable="False" />
            <TextBlock Text="{Binding Low.Name}" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.UI.Small}" />
            <ContentControl Content="{Binding Low}" ContentTemplate="{StaticResource RegisterChipTemplate}" Focusable="False" />
          </StackPanel>
        </WrapPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Main.IsChanged}" Value="True">
          <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Value.Changed}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- FlagCell: letter, 0/1/?, changed = color + weight + a 2 px underline; full name and meaning as tooltip and UIA name -->
    <DataTemplate x:Key="FlagCellTemplate">
      <StackPanel Width="26" Margin="1,0" ToolTip="{Binding Tooltip}">
        <TextBlock Text="{Binding Letter}" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
        <TextBlock x:Name="FlagValue" Text="{Binding Text}" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
        <Border x:Name="Marker" Height="2" Margin="3,1,3,0" Background="Transparent" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsChanged}" Value="True">
          <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="FlagValue" Property="Foreground" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="FlagValue" Property="FontWeight" Value="{DynamicResource FontWeight.Changed}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- TASK-082 HexByteGrid (UI-008): address, 16 bytes, ASCII; a changed byte = Value.Changed + bold + underline -->
    <DataTemplate x:Key="MemoryRowTemplate">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding Address}" Margin="0,0,10,0" Foreground="{DynamicResource Text.Secondary}"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Ascii}" Margin="10,0,0,0" Foreground="{DynamicResource Text.Secondary}"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
        <ItemsControl ItemsSource="{Binding Bytes}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock x:Name="ByteText" Text="{Binding Text}" Margin="0,0,6,0" Foreground="{DynamicResource Syntax.Number}"
                         FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                  <Setter TargetName="ByteText" Property="Foreground" Value="{DynamicResource Value.Changed}" />
                  <Setter TargetName="ByteText" Property="FontWeight" Value="{DynamicResource FontWeight.Changed}" />
                  <Setter TargetName="ByteText" Property="TextDecorations" Value="Underline" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </DataTemplate>
    <!-- UI-009 stack word: SP marker, offset in SS, the word in a box (changed as the register boxes) -->
    <DataTemplate x:Key="StackRowTemplate">
      <DockPanel Margin="0,1">
        <TextBlock x:Name="Top" DockPanel.Dock="Left" Width="34" Text="" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Left" Width="40" Text="{Binding Offset}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
        <Border x:Name="Chip" HorizontalAlignment="Left" Background="{DynamicResource Surface.Raised}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="6,0">
          <TextBlock x:Name="WordValue" Text="{Binding Value}" Foreground="{DynamicResource Syntax.Number}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
        </Border>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsTop}" Value="True">
          <Setter TargetName="Top" Property="Text" Value="{x:Static shell:Strings.StackMarker}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsChanged}" Value="True">
          <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="WordValue" Property="Foreground" Value="{DynamicResource Value.Changed}" />
          <Setter TargetName="WordValue" Property="FontWeight" Value="{DynamicResource FontWeight.Changed}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="MachineListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
    </Style>
    <Style x:Key="MachineList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- TASK-082 memory panel content (UI-008), used docked and in the compact layout's tab -->
    <DataTemplate x:Key="MemoryPanelTemplate">
      <DockPanel>
        <DockPanel.InputBindings>
          <KeyBinding Key="N" Modifiers="Ctrl+Alt" Command="{Binding CycleFormatCommand}" />
        </DockPanel.InputBindings>
        <DockPanel DockPanel.Dock="Top" Margin="4,2,4,2" Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
          <Label DockPanel.Dock="Left" Content="{x:Static shell:Strings.MemoryAddressLabel}" Target="{Binding ElementName=MemoryAddressBox}"
                 Padding="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
          <TextBox x:Name="MemoryAddressBox" DockPanel.Dock="Left" Width="110" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{DynamicResource Font.Code}" ToolTip="{x:Static shell:Strings.MemoryAddressHelp}"
                   AutomationProperties.HelpText="{x:Static shell:Strings.MemoryAddressHelp}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button DockPanel.Dock="Left" Content="{x:Static shell:Strings.MemoryGo}" Command="{Binding GoCommand}" Padding="10,0" Margin="6,0,0,0" />
          <TextBlock />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="6,0,6,2" Text="{Binding AddressError}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" Visibility="{Binding AddressError, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
        <Border DockPanel.Dock="Top" Padding="6,2" Background="{DynamicResource Surface.Raised}" Visibility="{Binding IsNotCurrent, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock Text="{x:Static shell:Strings.CpuNotCurrent}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
        </Border>
        <Grid>
          <TextBlock Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                     Visibility="{Binding HasValues, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
          <ListBox x:Name="MemoryRows" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource MemoryRowTemplate}" Margin="4,0"
                   AutomationProperties.Name="{x:Static shell:Strings.RegionMemoryRows}"
                   Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
            <ListBox.Style>
              <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}" />
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </DockPanel>
    </DataTemplate>
    <!-- TASK-082 stack panel content (UI-009): words from SS:SP upward, SP marked -->
    <DataTemplate x:Key="StackPanelTemplate">
      <Grid>
        <Grid.InputBindings>
          <KeyBinding Key="N" Modifiers="Ctrl+Alt" Command="{Binding CycleFormatCommand}" />
        </Grid.InputBindings>
        <TextBlock Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                   Visibility="{Binding HasValues, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
        <ListBox x:Name="StackRows" ItemsSource="{Binding StackRows}" ItemTemplate="{StaticResource StackRowTemplate}" Margin="4,2"
                 AutomationProperties.Name="{x:Static shell:Strings.RegionStackRows}"
                 Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
          <ListBox.Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
              <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                  <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}" />
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static shell:MainWindow.NextPaneCommand}" Executed="OnNextPane" />
    <CommandBinding Command="{x:Static shell:MainWindow.PreviousPaneCommand}" Executed="OnPreviousPane" />
    <CommandBinding Command="{x:Static shell:MainWindow.ToggleBreakpointCommand}" Executed="OnToggleBreakpoint" CanExecute="OnCanToggleBreakpoint" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}" />
    <!-- FR-022 zoom (also Ctrl+mouse wheel, handled in code-behind) and the Ctrl+M Tab mode. -->
    <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomResetCommand}" />
    <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding ZoomResetCommand}" />
    <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleTabMovesFocusCommand}" />
    <KeyBinding Key="F6" Command="{x:Static shell:MainWindow.NextPaneCommand}" />
    <KeyBinding Key="F6" Modifiers="Shift" Command="{x:Static shell:MainWindow.PreviousPaneCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Registers}" />
    <KeyBinding Key="F" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Flags}" />
    <KeyBinding Key="M" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Memory}" />
    <KeyBinding Key="K" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Stack}" />
    <KeyBinding Key="O" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Console}" />
    <KeyBinding Key="P" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Problems}" />
    <KeyBinding Key="U" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Runtime}" />
    <KeyBinding Key="H" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.History}" />
    <KeyBinding Key="B" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Breakpoints}" />
    <KeyBinding Key="L" Modifiers="Ctrl+Alt" Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Learn}" />
    <!-- File commands (ui-spec section 6) -->
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Workspace.NewFileCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding Workspace.OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Workspace.SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding Workspace.SaveAsCommand}" />
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Workspace.CloseTabCommand}" />
    <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding Workspace.CloseTabCommand}" />
    <!-- TASK-080: build and session commands (ui-spec section 6). F10 and Alt combinations arrive as system keys; the
         code-behind routes them to these bindings. -->
    <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding BuildRun.BuildCommand}" />
    <KeyBinding Key="Escape" Command="{Binding BuildRun.CancelBuildCommand}" />
    <KeyBinding Key="F5" Command="{Binding BuildRun.RunCommand}" />
    <KeyBinding Key="Cancel" Modifiers="Ctrl+Alt" Command="{Binding BuildRun.PauseCommand}" />
    <KeyBinding Key="Pause" Modifiers="Ctrl+Alt" Command="{Binding BuildRun.PauseCommand}" />
    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding BuildRun.StopCommand}" />
    <KeyBinding Key="F5" Modifiers="Ctrl+Shift" Command="{Binding BuildRun.ResetCommand}" />
    <KeyBinding Key="F11" Command="{Binding BuildRun.StepIntoCommand}" />
    <KeyBinding Key="F10" Command="{Binding BuildRun.StepOverCommand}" />
    <KeyBinding Key="F9" Command="{x:Static shell:MainWindow.ToggleBreakpointCommand}" />
    <KeyBinding Key="Cancel" Modifiers="Ctrl" Command="{Binding BuildRun.SendCtrlCCommand}" />
    <KeyBinding Key="F1" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Help}" />
  </Window.InputBindings>

  <DockPanel Background="{DynamicResource Surface.Window}">
    <!-- UI-002 menus. Commands owned by later tasks are shown (with their shortcuts) but disabled. -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static shell:Strings.RegionMenu}" Padding="4,2">
      <MenuItem Header="{x:Static shell:Strings.MenuFile}">
        <MenuItem Header="{x:Static shell:Strings.CmdNew}" InputGestureText="{x:Static shell:Strings.KeyNew}" Command="{Binding Workspace.NewFileCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdNewFromTemplate}" Command="{Binding Workspace.NewProgramCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdOpen}" InputGestureText="{x:Static shell:Strings.KeyOpen}" Command="{Binding Workspace.OpenCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdSave}" InputGestureText="{x:Static shell:Strings.KeySave}" Command="{Binding Workspace.SaveCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdSaveAs}" InputGestureText="{x:Static shell:Strings.KeySaveAs}" Command="{Binding Workspace.SaveAsCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdCloseTab}" InputGestureText="{x:Static shell:Strings.KeyCloseTab}" Command="{Binding Workspace.CloseTabCommand}" />
        <MenuItem x:Name="RecentMenu" Header="{x:Static shell:Strings.CmdRecent}" ItemsSource="{Binding Workspace.RecentFiles}"
                  IsEnabled="{Binding Workspace.HasRecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <!-- The path is the header; no access-key underscores in file names. -->
              <Setter Property="Header">
                <Setter.Value>
                  <TextBlock Text="{Binding}" />
                </Setter.Value>
              </Setter>
              <Setter Property="Command" Value="{Binding DataContext.Workspace.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdSettings}" InputGestureText="{x:Static shell:Strings.KeySettings}" Command="{Binding OpenSettingsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdExit}" InputGestureText="{x:Static shell:Strings.KeyExit}" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuEdit}">
        <MenuItem Header="{x:Static shell:Strings.CmdUndo}" InputGestureText="{x:Static shell:Strings.KeyUndo}" Command="ApplicationCommands.Undo" />
        <MenuItem Header="{x:Static shell:Strings.CmdRedo}" InputGestureText="{x:Static shell:Strings.KeyRedo}" Command="ApplicationCommands.Redo" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdCut}" InputGestureText="{x:Static shell:Strings.KeyCut}" Command="ApplicationCommands.Cut" />
        <MenuItem Header="{x:Static shell:Strings.CmdCopy}" InputGestureText="{x:Static shell:Strings.KeyCopy}" Command="ApplicationCommands.Copy" />
        <MenuItem Header="{x:Static shell:Strings.CmdPaste}" InputGestureText="{x:Static shell:Strings.KeyPaste}" Command="ApplicationCommands.Paste" />
        <MenuItem Header="{x:Static shell:Strings.CmdSelectAll}" InputGestureText="{x:Static shell:Strings.KeySelectAll}" Command="ApplicationCommands.SelectAll" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdFind}" InputGestureText="{x:Static shell:Strings.KeyFind}" Command="{Binding Find.FindCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdFindNext}" InputGestureText="{x:Static shell:Strings.KeyFindNext}" Command="{Binding Find.FindNextCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdFindPrevious}" InputGestureText="{x:Static shell:Strings.KeyFindPrevious}" Command="{Binding Find.FindPreviousCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdReplace}" InputGestureText="{x:Static shell:Strings.KeyReplace}" Command="{Binding Find.OpenReplaceCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdGoToLine}" InputGestureText="{x:Static shell:Strings.KeyGoToLine}" Command="{Binding Find.GoToLineCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdTabMovesFocus}" InputGestureText="{x:Static shell:Strings.KeyTabMovesFocus}" IsCheckable="True" IsChecked="{Binding TabMovesFocus}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuView}">
        <MenuItem Header="{x:Static shell:Strings.CmdNextPane}" InputGestureText="{x:Static shell:Strings.KeyNextPane}"
                  Command="{x:Static shell:MainWindow.NextPaneCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdPreviousPane}" InputGestureText="{x:Static shell:Strings.KeyPreviousPane}"
                  Command="{x:Static shell:MainWindow.PreviousPaneCommand}" />
        <MenuItem Header="{x:Static shell:Strings.MenuGoTo}">
          <MenuItem Header="{x:Static shell:Strings.GoRegisters}" InputGestureText="{x:Static shell:Strings.KeyGoRegisters}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Registers}" />
          <MenuItem Header="{x:Static shell:Strings.GoFlags}" InputGestureText="{x:Static shell:Strings.KeyGoFlags}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Flags}" />
          <MenuItem Header="{x:Static shell:Strings.GoMemory}" InputGestureText="{x:Static shell:Strings.KeyGoMemory}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Memory}" />
          <MenuItem Header="{x:Static shell:Strings.GoStack}" InputGestureText="{x:Static shell:Strings.KeyGoStack}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Stack}" />
          <Separator />
          <MenuItem Header="{x:Static shell:Strings.GoConsole}" InputGestureText="{x:Static shell:Strings.KeyGoConsole}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Console}" />
          <MenuItem Header="{x:Static shell:Strings.GoProblems}" InputGestureText="{x:Static shell:Strings.KeyGoProblems}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Problems}" />
          <MenuItem Header="{x:Static shell:Strings.GoRuntime}" InputGestureText="{x:Static shell:Strings.KeyGoRuntime}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Runtime}" />
          <MenuItem Header="{x:Static shell:Strings.GoHistory}" InputGestureText="{x:Static shell:Strings.KeyGoHistory}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.History}" />
          <MenuItem Header="{x:Static shell:Strings.GoBreakpoints}" InputGestureText="{x:Static shell:Strings.KeyGoBreakpoints}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Breakpoints}" />
          <MenuItem Header="{x:Static shell:Strings.GoLearn}" InputGestureText="{x:Static shell:Strings.KeyGoLearn}"
                    Command="{Binding GoToCommand}" CommandParameter="{x:Static shell:ShellPanel.Learn}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdShowLearn}" IsCheckable="True" IsChecked="{Binding IsLearnVisible}" />
        <MenuItem Header="{x:Static shell:Strings.CmdShowMachine}" IsCheckable="True" IsChecked="{Binding IsMachineVisible}" />
        <MenuItem Header="{x:Static shell:Strings.CmdShowBottom}" IsCheckable="True" IsChecked="{Binding IsBottomVisible}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomIn}" InputGestureText="{x:Static shell:Strings.KeyZoomIn}" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomOut}" InputGestureText="{x:Static shell:Strings.KeyZoomOut}" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdZoomReset}" InputGestureText="{x:Static shell:Strings.KeyZoomReset}" Command="{Binding ZoomResetCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdCycleFormat}" InputGestureText="{x:Static shell:Strings.KeyCycleFormat}" Command="{Binding BuildRun.Cpu.CycleFormatCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdResetLayout}" Command="{Binding ResetLayoutCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuBuild}">
        <MenuItem Header="{x:Static shell:Strings.CmdBuild}" InputGestureText="{x:Static shell:Strings.KeyBuild}" Command="{Binding BuildRun.BuildCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdCancelBuild}" InputGestureText="{x:Static shell:Strings.KeyCancelBuild}" Command="{Binding BuildRun.CancelBuildCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuDebug}">
        <MenuItem Header="{x:Static shell:Strings.CmdRun}" InputGestureText="{x:Static shell:Strings.KeyRun}" Command="{Binding BuildRun.RunCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdPause}" InputGestureText="{x:Static shell:Strings.KeyPause}" Command="{Binding BuildRun.PauseCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdStop}" InputGestureText="{x:Static shell:Strings.KeyStop}" Command="{Binding BuildRun.StopCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdReset}" InputGestureText="{x:Static shell:Strings.KeyReset}" Command="{Binding BuildRun.ResetCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdStepInto}" InputGestureText="{x:Static shell:Strings.KeyStepInto}" Command="{Binding BuildRun.StepIntoCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdStepOver}" InputGestureText="{x:Static shell:Strings.KeyStepOver}" Command="{Binding BuildRun.StepOverCommand}" />
        <MenuItem Header="{x:Static shell:Strings.CmdToggleBreakpoint}" InputGestureText="{x:Static shell:Strings.KeyToggleBreakpoint}" Command="{x:Static shell:MainWindow.ToggleBreakpointCommand}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdSendCtrlC}" InputGestureText="{x:Static shell:Strings.KeySendCtrlC}" Command="{Binding BuildRun.SendCtrlCCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuLearn}">
        <MenuItem Header="{x:Static shell:Strings.CmdSamples}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Sample}" />
        <MenuItem Header="{x:Static shell:Strings.CmdTutorials}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Tutorial}" />
        <MenuItem Header="{x:Static shell:Strings.CmdReference}" Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Reference}" />
      </MenuItem>
      <MenuItem Header="{x:Static shell:Strings.MenuHelp}">
        <MenuItem Header="{x:Static shell:Strings.CmdHelp}" InputGestureText="{x:Static shell:Strings.KeyHelp}"
                  Command="{Binding ShowLearnSectionCommand}" CommandParameter="{x:Static content:ContentKind.Help}" />
        <MenuItem Header="{x:Static shell:Strings.CmdReleaseNotes}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.ReleaseNotes}" />
        <MenuItem Header="{x:Static shell:Strings.CmdNotices}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.Notices}" />
        <Separator />
        <MenuItem Header="{x:Static shell:Strings.CmdAbout}" Command="{Binding OpenAboutCommand}" CommandParameter="{x:Static about:AboutPage.Diagnostics}" />
      </MenuItem>
    </Menu>

    <!-- UI-002 command bar. Session commands are disabled in the Empty state (ui-spec section 4). -->
    <Border DockPanel.Dock="Top" MinHeight="{DynamicResource Size.CommandBar}" Padding="8,2"
            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{x:Static shell:Strings.RegionCommandBar}">
        <Button x:Name="BarBuild" Style="{StaticResource CommandButton}" Tag="&#xE90F;" Content="{x:Static shell:Strings.BarBuild}" ToolTip="{x:Static shell:Strings.TipBuild}" Command="{Binding BuildRun.BuildCommand}" />
        <Button x:Name="BarRun" Style="{StaticResource CommandButton}" Tag="&#xE768;" Content="{x:Static shell:Strings.BarRun}" ToolTip="{x:Static shell:Strings.TipRun}" Command="{Binding BuildRun.RunCommand}" />
        <Button x:Name="BarPause" Style="{StaticResource CommandButton}" Tag="&#xE769;" Content="{x:Static shell:Strings.BarPause}" ToolTip="{x:Static shell:Strings.TipPause}" Command="{Binding BuildRun.PauseCommand}" />
        <Button x:Name="BarStop" Style="{StaticResource CommandButton}" Tag="&#xE71A;" Content="{x:Static shell:Strings.BarStop}" ToolTip="{x:Static shell:Strings.TipStop}" Command="{Binding BuildRun.StopCommand}" />
        <Button x:Name="BarReset" Style="{StaticResource CommandButton}" Tag="&#xE72C;" Content="{x:Static shell:Strings.BarReset}" ToolTip="{x:Static shell:Strings.TipReset}" Command="{Binding BuildRun.ResetCommand}" />
        <Button x:Name="BarStepInto" Style="{StaticResource CommandButton}" Tag="&#xE74B;" Content="{x:Static shell:Strings.BarStepInto}" ToolTip="{x:Static shell:Strings.TipStepInto}" Command="{Binding BuildRun.StepIntoCommand}" />
        <Button x:Name="BarStepOver" Style="{StaticResource CommandButton}" Tag="&#xE7A6;" Content="{x:Static shell:Strings.BarStepOver}" ToolTip="{x:Static shell:Strings.TipStepOver}" Command="{Binding BuildRun.StepOverCommand}" />
        <!-- UI-002 state badge: glyph + words; a polite live region, announced when it changes (code-behind) -->
        <TextBlock x:Name="StateBadge" Text="{Binding BuildRun.BadgeText}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   AutomationProperties.HelpText="{x:Static shell:Strings.RegionStateBadge}" />
        <!-- FR-093 (TASK-085): screen-reader announcements, one per step/pause/halt/end; a polite live region raised by the code-behind.
             1 x 1 and transparent: present in the UI Automation tree, not visible. -->
        <TextBlock x:Name="AnnouncementRegion" Width="1" Height="1" Opacity="0" Focusable="False" Text="{Binding BuildRun.Announcement}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>

    <!-- UI-016 status bar. -->
    <Border DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0"
            AutomationProperties.Name="{x:Static shell:Strings.RegionStatusBar}">
      <DockPanel>
        <!-- Encoding and line endings of the active document (ui-spec section 5) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Workspace.ActiveDocument}"
                    Visibility="{Binding DataContext.Workspace.HasDocuments, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock x:Name="StatusEncoding" Text="{Binding StatusEncoding}" Foreground="{DynamicResource Text.Secondary}"
                     FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
          <TextBlock x:Name="StatusCaret" Text="{Binding StatusCaret}" Foreground="{DynamicResource Text.Secondary}"
                     FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
          <TextBlock x:Name="StatusLineEnding" Text="{Binding StatusLineEnding}" Foreground="{DynamicResource Text.Secondary}"
                     FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="StatusAssembler" DockPanel.Dock="Right" Text="{Binding BuildRun.AssemblerText}" Foreground="{DynamicResource Text.Secondary}"
                   FontSize="{DynamicResource FontSize.UI.Small}" Margin="16,0,0,0" />
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.UI.Small}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{Binding BuildRun.StatusText}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding BuildRun.StatusText}" Value="">
                  <Setter Property="Text" Value="{Binding StatusText}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- Regions (ui-spec section 2). Sizes and visibility are applied by the code-behind from the view model. -->
    <Grid x:Name="RegionGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LearnColumn" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="MachineColumn" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="BottomRow" />
      </Grid.RowDefinitions>

      <!-- UI-015 Learn sidebar -->
      <GroupBox x:Name="LearnPanel" Grid.Column="0" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderLearn}"
                AutomationProperties.Name="{x:Static shell:Strings.RegionLearn}">
        <Grid DataContext="{Binding Learn}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TreeView x:Name="LearnTree" ItemsSource="{Binding Sections}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Background="Transparent" Foreground="{DynamicResource Text.Primary}"
                    AutomationProperties.Name="{x:Static shell:Strings.LearnTreeName}" SelectedItemChanged="OnLearnSelectionChanged">
            <TreeView.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
            </TreeView.InputBindings>
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type learn:LearnSectionViewModel}" ItemsSource="{Binding Items}">
                <StackPanel>
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Text.Secondary}" FontStyle="Italic"
                             Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
              </HierarchicalDataTemplate>
              <DataTemplate DataType="{x:Type learn:LearnItemViewModel}">
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Summary}" />
              </DataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                <Setter Property="ItemContainerStyle">
                  <Setter.Value>
                    <Style TargetType="TreeViewItem">
                      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                      <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
                    </Style>
                  </Setter.Value>
                </Setter>
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,4" />
          <!-- Details of the selected entry -->
          <DockPanel x:Name="LearnDetails" Grid.Row="2" Margin="4,0,4,4">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.LearnSelectHint}"
                       Visibility="{Binding HasSelection, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,6" />
            <Button x:Name="LearnOpenTutorialSample" DockPanel.Dock="Top" Command="{Binding OpenLinkedSampleCommand}"
                    HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,6"
                    AutomationProperties.Name="{Binding LinkedSampleLabel}"
                    Visibility="{Binding LinkedSampleLabel, Converter={x:Static shell:NullToCollapsedConverter.Instance}}">
              <TextBlock Text="{Binding LinkedSampleLabel}" TextWrapping="Wrap" />
            </Button>
            <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsSampleSelected, Converter={StaticResource VisibleWhenTrue}}">
              <Button x:Name="LearnOpenCopy" Content="{x:Static shell:Strings.LearnOpenCopy}" Command="{Binding OpenSelectedCommand}"
                      HorizontalAlignment="Left" Padding="12,4" />
              <TextBlock Text="{x:Static shell:Strings.LearnOpenCopyHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static shell:Strings.LearnExplanation}" Foreground="{DynamicResource Text.Secondary}"
                       FontStyle="Italic" Margin="0,0,0,2"
                       Visibility="{Binding SelectedText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
            <TextBox x:Name="LearnText" Text="{Binding SelectedText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4"
                     Background="{DynamicResource Surface.Raised}" Foreground="{DynamicResource Text.Primary}"
                     Visibility="{Binding SelectedText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}"
                     AutomationProperties.Name="{x:Static shell:Strings.LearnTextName}" />
          </DockPanel>
        </Grid>
      </GroupBox>
      <GridSplitter x:Name="LearnSplitter" Grid.Column="1" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterLearn}" />

      <!-- UI-003 editor area: document tabs (the AvalonEdit editor replaces the text boxes in TASK-064), or the UI-020 welcome page -->
      <GroupBox x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource Panel.Headerless}"
                AutomationProperties.Name="{x:Static shell:Strings.RegionEditor}" DataContext="{Binding Workspace}">
        <GroupBox.InputBindings>
          <!-- ui-spec section 6, TASK-065: find, replace and go to line work in the editor and in the find bar -->
          <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding DataContext.Find.FindCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          <KeyBinding Key="F3" Command="{Binding DataContext.Find.FindNextCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding DataContext.Find.FindPreviousCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding DataContext.Find.OpenReplaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding DataContext.Find.GoToLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </GroupBox.InputBindings>
        <Grid>
          <!-- UI-020 welcome page: no document open -->
          <ScrollViewer x:Name="WelcomePage" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static shell:Strings.RegionWelcome}">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasDocuments}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="16">
              <TextBlock Style="{StaticResource EmptyState.Title}" Text="{x:Static shell:Strings.WelcomeTitle}" />
              <TextBlock Style="{StaticResource EmptyState.Text}" TextAlignment="Center" Text="{x:Static shell:Strings.WelcomeText}" />
              <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="WelcomeNew" Content="{x:Static shell:Strings.WelcomeNew}" Command="{Binding NewFileCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeNewProgram" Content="{x:Static shell:Strings.WelcomeNewTemplate}" Command="{Binding NewProgramCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeOpen" Content="{x:Static shell:Strings.WelcomeOpen}" Command="{Binding OpenCommand}" Margin="4" Padding="12,4" />
                <Button x:Name="WelcomeSample" Content="{x:Static shell:Strings.WelcomeSample}" Margin="4" Padding="12,4"
                        Command="{Binding DataContext.ShowLearnSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static content:ContentKind.Sample}" />
              </WrapPanel>
              <TextBlock Text="{x:Static shell:Strings.WelcomeRecent}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="4,20,4,4" />
              <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.WelcomeNoRecent}"
                         Visibility="{Binding HasRecentFiles, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
              <ItemsControl x:Name="WelcomeRecent" ItemsSource="{Binding RecentFiles}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" HorizontalContentAlignment="Left" Margin="4,1" Padding="8,2"
                            AutomationProperties.Name="{Binding}">
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Open documents -->
          <DockPanel x:Name="DocumentArea" Visibility="{Binding HasDocuments, Converter={StaticResource VisibleWhenTrue}}">
            <!-- Tab strip only: each document keeps its own editor below, so caret and undo history stay per tab (AC-006). -->
            <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                        AutomationProperties.Name="{x:Static shell:Strings.RegionDocumentTabs}">
              <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                  <Setter Property="ToolTip" Value="{Binding FilePath}" />
                </Style>
              </TabControl.ItemContainerStyle>
              <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" />
                    <Button Margin="8,0,0,0" Padding="2,0" FontFamily="{DynamicResource Font.Icons}" FontSize="10" Content="&#xE711;"
                            Focusable="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Secondary}"
                            ToolTip="{x:Static shell:Strings.CmdCloseTabShort}" AutomationProperties.Name="{x:Static shell:Strings.CmdCloseTabShort}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
              <TabControl.ContentTemplate>
                <DataTemplate />
              </TabControl.ContentTemplate>
            </TabControl>

            <!-- UI-007 current-instruction strip (TASK-083): only while a program is loaded -->
            <Border x:Name="InstructionStrip" DockPanel.Dock="Top" Padding="8,3" Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    DataContext="{Binding DataContext.BuildRun.Strip, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsVisible, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.Name="{x:Static shell:Strings.RegionInstructionStrip}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Margin="12,0,0,0" Foreground="{DynamicResource Text.Secondary}"
                             Visibility="{Binding Note, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
                  <TextBlock x:Name="StripText" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Text}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                            <Setter Property="Text" Value="{x:Static shell:Strings.StripNotCurrent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DockPanel>
                <TextBlock x:Name="StripHalt" Text="{Binding HaltText}" Foreground="{DynamicResource Status.Error}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HaltText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
              </StackPanel>
            </Border>
            <!-- UI-004 find and replace bar (TASK-065): works on the active editor; Esc closes it and returns to the editor -->
            <Border x:Name="FindBar" DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    DataContext="{Binding DataContext.Find, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.Name="{x:Static shell:Strings.FindBarName}">
              <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
              </Border.InputBindings>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="FindBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="4,1"
                         FontFamily="{DynamicResource Font.Code}" AutomationProperties.Name="{x:Static shell:Strings.FindBoxName}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FindNextCommand}" />
                    <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                  <Button x:Name="FindPreviousButton" Content="&#xE70E;" FontFamily="{DynamicResource Font.Icons}" Padding="6,2" Command="{Binding FindPreviousCommand}"
                          ToolTip="{x:Static shell:Strings.FindPreviousButton}" AutomationProperties.Name="{x:Static shell:Strings.FindPreviousButton}" />
                  <Button x:Name="FindNextButton" Content="&#xE70D;" FontFamily="{DynamicResource Font.Icons}" Padding="6,2" Margin="2,0,0,0" Command="{Binding FindNextCommand}"
                          ToolTip="{x:Static shell:Strings.FindNextButton}" AutomationProperties.Name="{x:Static shell:Strings.FindNextButton}" />
                  <CheckBox x:Name="FindMatchCase" Content="{x:Static shell:Strings.FindMatchCase}" IsChecked="{Binding MatchCase}" VerticalAlignment="Center" Margin="10,0,0,0" />
                  <CheckBox x:Name="FindWholeWord" Content="{x:Static shell:Strings.FindWholeWord}" IsChecked="{Binding WholeWord}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <DockPanel Grid.Column="2" Margin="10,0,0,0" LastChildFill="True">
                  <Button x:Name="FindCloseButton" DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{DynamicResource Font.Icons}" FontSize="10" Padding="6,2"
                          Command="{Binding CloseCommand}" ToolTip="{x:Static shell:Strings.FindClose}" AutomationProperties.Name="{x:Static shell:Strings.FindClose}" />
                  <TextBlock x:Name="FindStatus" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                             TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
                <TextBox x:Name="ReplaceBox" Grid.Row="1" Margin="0,4,0,0" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Padding="4,1"
                         FontFamily="{DynamicResource Font.Code}" AutomationProperties.Name="{x:Static shell:Strings.FindReplaceBoxName}"
                         Visibility="{Binding IsReplaceShown, Converter={StaticResource VisibleWhenTrue}}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ReplaceCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="6,4,0,0"
                            Visibility="{Binding IsReplaceShown, Converter={StaticResource VisibleWhenTrue}}">
                  <Button x:Name="ReplaceButton" Content="{x:Static shell:Strings.FindReplaceOne}" Padding="10,1" Command="{Binding ReplaceCommand}" />
                  <Button x:Name="ReplaceAllButton" Content="{x:Static shell:Strings.FindReplaceAll}" Padding="10,1" Margin="6,0,0,0" Command="{Binding ReplaceAllCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl x:Name="DocumentEditors" ItemsSource="{Binding Documents}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Grid />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource VisibleWhenTrue}}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
                  <DockPanel>
                    <!-- ui-spec §5: edited while a session runs an earlier build -->
                    <Border x:Name="StaleSessionBanner" DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Status.Warning}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsSessionStale, Converter={StaticResource VisibleWhenTrue}}">
                      <TextBlock Text="{x:Static shell:Strings.BannerSessionStale}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <!-- FR-019: not UTF-8 -->
                    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Status.Warning}" BorderThickness="0,0,0,1"
                            Visibility="{Binding EncodingNotice, Converter={x:Static shell:NullToCollapsedConverter.Instance}}">
                      <TextBlock Text="{Binding EncodingNotice}" TextWrapping="Wrap" />
                    </Border>
                    <!-- FR-020: mixed line endings -->
                    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Status.Warning}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasMixedLineEndings, Converter={StaticResource VisibleWhenTrue}}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static shell:Strings.BannerNormalize}" Padding="8,2" Margin="8,0,0,0"
                                Command="{Binding DataContext.NormalizeLineEndingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{x:Static shell:Strings.BannerMixedLineEndings}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <!-- UI-003 code editor (AvalonEdit, TASK-064): one instance per document keeps caret and undo per tab (AC-006). -->
                    <editor:CodeEditor x:Name="EditorText" BoundText="{Binding Text, Mode=TwoWay}"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource Font.Editor}" FontSize="{DynamicResource FontSize.Editor}"
                             Background="{DynamicResource Surface.Editor}" Foreground="{DynamicResource Syntax.Text}"
                             LineNumbersForeground="{DynamicResource Text.Secondary}"
                             TabWidth="{DynamicResource Editor.TabWidth}" UseSpaces="{DynamicResource Editor.UseSpaces}"
                             TabMovesFocus="{Binding DataContext.TabMovesFocus, RelativeSource={RelativeSource AncestorType=Window}}"
                             Diagnostics="{Binding Diagnostics}" Breakpoints="{Binding Breakpoints}"
                             ExecutionLine="{Binding ExecutionLine}" ExecutionMarker="{Binding ExecutionMarker}"
                             ToggleBreakpointCommand="{Binding ToggleBreakpointCommand}"
                             CaretLine="{Binding CaretLine, Mode=OneWayToSource}" CaretColumn="{Binding CaretColumn, Mode=OneWayToSource}"
                             BorderThickness="0" Padding="4,2" AutomationProperties.Name="{Binding Title}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Grid>
      </GroupBox>

      <GridSplitter x:Name="MachineSplitter" Grid.Column="3" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterMachine}" />

      <!-- Machine column: UI-005 registers above UI-006 flags -->
      <Grid x:Name="MachineRegion" Grid.Column="4" AutomationProperties.Name="{x:Static shell:Strings.RegionMachine}">
        <Grid.InputBindings>
          <!-- ui-spec section 6: Cycle number format, when a machine panel has focus -->
          <KeyBinding Key="N" Modifiers="Ctrl+Alt" Command="{Binding BuildRun.Cpu.CycleFormatCommand}" />
        </Grid.InputBindings>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- UI-005 registers (TASK-081): values of the latest paused snapshot only (NFR-018) -->
        <GroupBox x:Name="RegistersPanel" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderRegisters}">
          <DockPanel DataContext="{Binding BuildRun.Cpu}">
            <DockPanel DockPanel.Dock="Top" Margin="4,2,4,4" Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
              <ComboBox x:Name="NumberFormatList" Width="104" HorizontalAlignment="Left" SelectedIndex="{Binding FormatIndex}"
                        AutomationProperties.Name="{x:Static shell:Strings.RegionNumberFormat}" ToolTip="{x:Static shell:Strings.KeyCycleFormat}">
                <ComboBoxItem Content="{x:Static shell:Strings.FormatHex}" />
                <ComboBoxItem Content="{x:Static shell:Strings.FormatUnsigned}" />
                <ComboBoxItem Content="{x:Static shell:Strings.FormatSigned}" />
                <ComboBoxItem Content="{x:Static shell:Strings.FormatBinary}" />
              </ComboBox>
            </DockPanel>
            <Border x:Name="RegistersNotCurrent" DockPanel.Dock="Top" Padding="6,2" Background="{DynamicResource Surface.Raised}"
                    Visibility="{Binding IsNotCurrent, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="{x:Static shell:Strings.CpuNotCurrent}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            </Border>
            <Grid>
              <TextBlock x:Name="RegistersEmpty" Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                         Visibility="{Binding HasValues, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                          <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ListBox x:Name="RegisterList" Style="{StaticResource MachineList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RegisterRowTemplate}"
                           HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static shell:Strings.RegionRegisters}">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}" />
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </GroupBox>
        <!-- UI-006 flags (TASK-081): 0, 1 or "?" when the last instruction left the flag undefined (FR-048) -->
        <GroupBox x:Name="FlagsPanel" Grid.Row="1" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderFlags}"
                  BorderThickness="0,1,0,0" MinHeight="96">
          <Grid DataContext="{Binding BuildRun.Cpu}">
            <TextBlock x:Name="FlagsEmpty" Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                       Visibility="{Binding HasValues, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
            <ListBox x:Name="FlagList" ItemsSource="{Binding Flags}" ItemTemplate="{StaticResource FlagCellTemplate}"
                     Margin="4" AutomationProperties.Name="{x:Static shell:Strings.RegionFlags}"
                     Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
              <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                      <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.Style>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}">
                  <Setter Property="AutomationProperties.HelpText" Value="{Binding Tooltip}" />
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>
        </GroupBox>
      </Grid>

      <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Grid.ColumnSpan="5" Height="{DynamicResource Size.Splitter}"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows" AutomationProperties.Name="{x:Static shell:Strings.SplitterBottom}" />

      <!-- Bottom area: UI-010..UI-014 tab group; UI-008 memory and UI-009 stack beside it (tabs when compact) -->
      <Grid x:Name="BottomRegion" Grid.Row="2" Grid.ColumnSpan="5" AutomationProperties.Name="{x:Static shell:Strings.RegionBottom}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition x:Name="MemoryStackColumn" />
        </Grid.ColumnDefinitions>
        <TabControl x:Name="BottomTabs" SelectedIndex="{Binding BottomTab, Converter={x:Static shell:EnumIndexConverter.Instance}}"
                    AutomationProperties.Name="{x:Static shell:Strings.RegionBottomTabs}">
          <TabItem Header="{x:Static shell:Strings.TabConsole}">
            <!-- UI-010 program console (TASK-084) -->
            <DockPanel x:Name="ConsolePanel" DataContext="{Binding BuildRun.Console}">
              <Border DockPanel.Dock="Top" Padding="8,3" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Accent.Primary}"
                      BorderThickness="0,0,0,1" Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock x:Name="ConsoleWaiting" Text="{x:Static shell:Strings.ConsoleWaiting}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
              </Border>
              <Border DockPanel.Dock="Top" Padding="8,3" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Status.Warning}"
                      BorderThickness="0,0,0,1" Visibility="{Binding TrimmedNotice, Converter={x:Static shell:NullToCollapsedConverter.Instance}}">
                <TextBlock x:Name="ConsoleTrimmed" Text="{Binding TrimmedNotice}" TextWrapping="Wrap" />
              </Border>
              <TextBlock x:Name="ConsoleEnded" DockPanel.Dock="Bottom" Margin="8,2" Text="{Binding EndedText}" Foreground="{DynamicResource Text.Secondary}"
                         FontFamily="{DynamicResource Font.Code}" AutomationProperties.LiveSetting="Polite"
                         Visibility="{Binding EndedText, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
              <Grid>
                <console:ConsoleView x:Name="ConsoleOutput" Console="{Binding}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}"
                                     AutomationProperties.Name="{x:Static shell:Strings.RegionConsole}">
                  <console:ConsoleView.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static shell:Strings.ConsoleCopy}" InputGestureText="{x:Static shell:Strings.KeyConsoleCopy}"
                                Command="{x:Static console:ConsoleView.CopyAll}" />
                      <MenuItem Header="{x:Static shell:Strings.CmdSelectAll}" InputGestureText="{x:Static shell:Strings.KeySelectAll}" Command="ApplicationCommands.SelectAll" />
                    </ContextMenu>
                  </console:ConsoleView.ContextMenu>
                </console:ConsoleView>
                <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyConsole}" IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{x:Static shell:Strings.TabProblems}">
            <DockPanel x:Name="ProblemsPanel" DataContext="{Binding BuildRun.Problems}">
              <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Status.Warning}"
                      BorderThickness="0,0,0,1" Visibility="{Binding IsOutdated, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{x:Static shell:Strings.ProblemsOutdated}" TextWrapping="Wrap" />
              </Border>
              <Button x:Name="ProblemsOpenSettings" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="8,6,0,0" Padding="12,2"
                      Content="{x:Static shell:Strings.ProblemsOpenSettings}"
                      Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding OffersSettings, Converter={StaticResource VisibleWhenTrue}}" />
              <Grid>
                <TextBlock x:Name="ProblemsEmpty" Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <ListBox x:Name="ProblemsList" ItemsSource="{Binding Items}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         Background="Transparent" Foreground="{DynamicResource Text.Primary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static shell:Strings.RegionProblems}"
                         Visibility="{Binding IsEmpty, Converter={x:Static shell:InverseVisibilityConverter.Instance}}">
                  <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ActivateCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ListBox.InputBindings>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
                      <EventSetter Event="MouseDoubleClick" Handler="OnProblemDoubleClick" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="2,1">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="18" FontWeight="Bold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Status.Info}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Diagnostic.Severity}" Value="Error">
                                  <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Diagnostic.Severity}" Value="Warning">
                                  <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Diagnostic.Code}" Width="64" Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" Margin="12,0,0,0" Foreground="{DynamicResource Text.Secondary}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Diagnostic.What}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Diagnostic.NextStep}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                                     FontSize="{DynamicResource FontSize.UI.Small}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </DockPanel>
          </TabItem>
          <!-- UI-012 runtime messages (TASK-083) -->
          <TabItem Header="{x:Static shell:Strings.TabRuntime}">
            <DockPanel DataContext="{Binding BuildRun.Messages}">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4" Visibility="{Binding OffersBudgetChoice, Converter={StaticResource VisibleWhenTrue}}">
                <Button x:Name="BudgetContinue" Content="{x:Static shell:Strings.MessagesContinue}" Padding="12,2"
                        Command="{Binding DataContext.BuildRun.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button x:Name="BudgetStop" Content="{x:Static shell:Strings.MessagesStop}" Padding="12,2" Margin="8,0,0,0"
                        Command="{Binding DataContext.BuildRun.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              </StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyRuntime}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <ListBox x:Name="MessagesList" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static shell:Strings.RegionMessages}"
                         AutomationProperties.LiveSetting="Polite" Visibility="{Binding IsEmpty, Converter={x:Static shell:InverseVisibilityConverter.Instance}}">
                  <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                  </ListBox.Style>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}" />
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="2,2">
                        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Width="18" Text="{Binding Glyph}" FontWeight="Bold" Foreground="{DynamicResource Status.Info}" />
                        <TextBlock DockPanel.Dock="Left" Width="64" Text="{Binding Code}" Foreground="{DynamicResource Text.Secondary}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.UI.Small}"
                                     Visibility="{Binding NextStep, Converter={x:Static shell:NullToCollapsedConverter.Instance}}" />
                        </StackPanel>
                      </DockPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Error}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Status.Warning}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </DockPanel>
          </TabItem>
          <!-- UI-013 execution history (TASK-083) -->
          <TabItem Header="{x:Static shell:Strings.TabHistory}">
            <Grid DataContext="{Binding BuildRun.History}">
              <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyHistory}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
              <ListBox x:Name="HistoryList" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static shell:Strings.RegionHistory}"
                       Visibility="{Binding IsEmpty, Converter={x:Static shell:InverseVisibilityConverter.Instance}}">
                <ListBox.Style>
                  <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}">
                    <EventSetter Event="MouseDoubleClick" Handler="OnHistoryDoubleClick" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Width="86" Text="{Binding Address}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
                      <TextBlock Width="150" Text="{Binding Bytes}" Foreground="{DynamicResource Syntax.Number}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
                      <TextBlock Width="220" Text="{Binding Disassembly}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
                      <TextBlock Text="{Binding LineText}" Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <!-- UI-014 breakpoints (TASK-083) -->
          <TabItem Header="{x:Static shell:Strings.TabBreakpoints}">
            <DockPanel DataContext="{Binding BuildRun.Breakpoints}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4" Visibility="{Binding IsEmpty, Converter={x:Static shell:InverseVisibilityConverter.Instance}}">
                <Button x:Name="BreakpointToggle" Content="{x:Static shell:Strings.BreakpointsToggle}" Padding="10,1"
                        Command="{Binding ToggleEnabledCommand}" CommandParameter="{Binding SelectedItem, ElementName=BreakpointList}" />
                <Button x:Name="BreakpointRemove" Content="{x:Static shell:Strings.BreakpointsRemove}" Padding="10,1" Margin="6,0,0,0"
                        Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, ElementName=BreakpointList}" />
              </StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource EmptyState.Text}" Text="{x:Static shell:Strings.EmptyBreakpoints}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <ListBox x:Name="BreakpointList" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static shell:Strings.RegionBreakpoints}"
                         Visibility="{Binding IsEmpty, Converter={x:Static shell:InverseVisibilityConverter.Instance}}">
                  <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                  </ListBox.Style>
                  <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <KeyBinding Key="Space" Command="{Binding ToggleEnabledCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ListBox.InputBindings>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}">
                      <EventSetter Event="MouseDoubleClick" Handler="OnBreakpointDoubleClick" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Marker" Width="18" Text="●" Foreground="{DynamicResource Accent.Breakpoint}" />
                        <TextBlock Width="180" Text="{Binding Location}" />
                        <TextBlock x:Name="State" Text="{Binding State}" Foreground="{DynamicResource Text.Secondary}" FontFamily="{DynamicResource Font.Code}" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Breakpoint.IsEnabled}" Value="False">
                          <Setter TargetName="Marker" Property="Text" Value="○" />
                          <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Breakpoint.Binding}" Value="Unbound">
                          <Setter TargetName="Marker" Property="Text" Value="○" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHit}" Value="True">
                          <Setter TargetName="Marker" Property="Text" Value="➜" />
                          <Setter TargetName="State" Property="FontWeight" Value="Bold" />
                          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Value.Changed}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </DockPanel>
          </TabItem>
          <!-- UI-023 variables (TASK-106): the program's data labels and their current values -->
          <TabItem x:Name="VariablesTab" Header="{x:Static shell:Strings.TabVariables}">
            <Grid DataContext="{Binding BuildRun.Variables}">
              <Grid.InputBindings>
                <KeyBinding Key="N" Modifiers="Ctrl+Alt" Command="{Binding DataContext.BuildRun.Memory.CycleFormatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              </Grid.InputBindings>
              <TextBlock Style="{StaticResource EmptyState.Text}" Text="{Binding EmptyText}"
                         Visibility="{Binding HasValues, Converter={x:Static shell:InverseVisibilityConverter.Instance}}" />
              <DockPanel Visibility="{Binding HasValues, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,4,2" TextElement.Foreground="{DynamicResource Text.Secondary}">
                  <TextBlock Width="140" Text="{x:Static shell:Strings.VariableHeaderName}" />
                  <TextBlock Width="100" Text="{x:Static shell:Strings.VariableHeaderAddress}" />
                  <TextBlock Text="{x:Static shell:Strings.VariableHeaderValue}" />
                </StackPanel>
                <ListBox x:Name="VariableList" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch" Margin="4,0,4,2"
                         AutomationProperties.Name="{x:Static shell:Strings.RegionVariables}">
                  <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource MachineList}">
                      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotCurrent}" Value="True">
                          <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ListBox.Style>
                  <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ShowInMemoryCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                  </ListBox.InputBindings>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MachineListItem}">
                      <Setter Property="ToolTip" Value="{x:Static shell:Strings.VariableShowInMemory}" />
                      <EventSetter Event="MouseDoubleClick" Handler="OnVariableDoubleClick" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1">
                        <TextBlock DockPanel.Dock="Left" Width="140" Text="{Binding Name}" Foreground="{DynamicResource Accent.Primary}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock DockPanel.Dock="Left" Width="100" Text="{Binding Address}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
                        <Border x:Name="Chip" HorizontalAlignment="Left" Background="{DynamicResource Surface.Raised}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="6,0">
                          <TextBlock x:Name="VariableValue" Text="{Binding Value}" Foreground="{DynamicResource Syntax.Number}" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}" />
                        </Border>
                      </DockPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                          <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Value.Changed}" />
                          <Setter TargetName="VariableValue" Property="Foreground" Value="{DynamicResource Value.Changed}" />
                          <Setter TargetName="VariableValue" Property="FontWeight" Value="{DynamicResource FontWeight.Changed}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Grid>
          </TabItem>
          <TabItem x:Name="MemoryTab" Header="{x:Static shell:Strings.TabMemory}">
            <ContentControl Content="{Binding BuildRun.Memory}" ContentTemplate="{StaticResource MemoryPanelTemplate}" Focusable="False" />
          </TabItem>
          <TabItem x:Name="StackTab" Header="{x:Static shell:Strings.TabStack}">
            <ContentControl Content="{Binding BuildRun.Memory}" ContentTemplate="{StaticResource StackPanelTemplate}" Focusable="False" />
          </TabItem>
        </TabControl>
        <GridSplitter x:Name="MemoryStackSplitter" Grid.Column="1" Width="{DynamicResource Size.Splitter}" HorizontalAlignment="Stretch"
                      ResizeDirection="Columns" AutomationProperties.Name="{x:Static shell:Strings.SplitterMemoryStack}" />
        <Grid x:Name="MemoryStackGroup" Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <GroupBox x:Name="MemoryPanel" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderMemory}">
            <ContentControl x:Name="MemoryDocked" Content="{Binding BuildRun.Memory}" ContentTemplate="{StaticResource MemoryPanelTemplate}" Focusable="False" />
          </GroupBox>
          <GroupBox x:Name="StackView" Grid.Column="1" Width="180" Style="{StaticResource Panel}" Header="{x:Static shell:Strings.HeaderStack}"
                    BorderThickness="1,0,0,0">
            <ContentControl x:Name="StackDocked" Content="{Binding BuildRun.Memory}" ContentTemplate="{StaticResource StackPanelTemplate}" Focusable="False" />
          </GroupBox>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
