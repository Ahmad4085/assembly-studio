# Line endings: the repository uses LF everywhere, in the index and in working trees, regardless of core.autocrlf.
# Matches .editorconfig (end_of_line = lf).
* text=auto eol=lf

# Windows command scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary content.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary
*.exe binary
*.dll binary
*.com binary
*.bin binary
